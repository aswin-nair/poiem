{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs local",
    "dev:cloud": "node scripts/dev.mjs neon",
    "build": "node scripts/build.mjs",
    "build:local": "node scripts/build.mjs local",
    "build:cloud": "node scripts/build.mjs neon",
    "build:release": "node scripts/build.mjs neon --release",
    "brand:build": "node scripts/build-brand-assets.mjs",
    "verify:cloud-build": "node scripts/verify-cloud-build.mjs",
    "lint": "oxlint",
    "preview": "vite preview --mode production",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "visual": "node scripts/visual.mjs",
    "visual:update": "node scripts/visual.mjs --update",
    "visual:sheet": "node scripts/contact-sheet.mjs",
    "ci": "npm run lint && npm run test && npm run build:local && npm run test:e2e"
  },
  "dependencies": {
    "@fud-ai/contracts": "file:../../packages/contracts",
    "@fud-ai/domain": "file:../../packages/domain",
    "@fud-ai/product": "file:../../packages/product",
    "@react-oauth/google": "^0.13.5",
    "jwt-decode": "^4.0.0",
    "lucide-react": "1.41.0",
    "motion": "^13.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
