{
  "name": "fud-ai-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:all": "npx vercel dev --yes --listen 3001",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:security": "node scripts/migrate.mjs security",
    "db:migrate:refresh": "node scripts/migrate.mjs refresh",
    "db:migrate:entities": "node scripts/migrate.mjs entities",
    "db:migrate:plans": "node scripts/migrate.mjs plans",
    "db:migrate:ops": "node scripts/migrate.mjs ops",
    "db:audit-byok": "node scripts/audit-byok.mjs",
    "db:retention-cleanup": "node scripts/retention-cleanup.mjs",
    "db:retention-rehearsal": "node scripts/retention-rehearsal.mjs",
    "test:api": "vitest run --config test/api/vitest.config.ts",
    "test:staging": "node scripts/staging-lifecycle.mjs",
    "verify:deploy": "node scripts/verify-deploy-context.mjs",
    "typecheck:api": "tsc -p api/tsconfig.json --noEmit",
    "cf:dev": "wrangler dev",
    "cf:build": "npm run build:cloud --prefix app",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "typecheck:worker": "tsc -p cloudflare/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fud-ai/contracts": "file:../packages/contracts",
    "@fud-ai/domain": "file:../packages/domain",
    "@neondatabase/serverless": "^1.0.2",
    "esbuild": "^0.27.0",
    "jose": "^6.1.3"
  },
  "overrides": {
    "brace-expansion": "1.1.18",
    "js-yaml": "4.3.2",
    "minimatch": "10.2.6",
    "path-to-regexp": "6.3.0",
    "smol-toml": "1.6.1",
    "tar": "7.5.22",
    "undici": "6.28.0"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@vercel/node": "^5.3.21",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "^4.131.0"
  }
}
